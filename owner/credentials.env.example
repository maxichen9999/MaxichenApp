# =====================================================================
# 🔐 credentials.env — VORLAGE
# ---------------------------------------------------------------------
# So benutzen:
#   cp credentials.env.example credentials.env
#   chmod 600 credentials.env
#   nano credentials.env
#
# Auf dem Server laden:
#   set -a; . ./owner/credentials.env; set +a
#   (NICHT: export $(cat ... | xargs) — zerbricht an Leerzeichen)
#
# ⚠️ Diese Vorlage enthält KEINE echten Werte. Die echte Datei heißt
#    credentials.env, ist 0600 und liegt NIE im ZIP.
# =====================================================================

# ⚠️ WERTE MIT LEERZEICHEN ODER SONDERZEICHEN (& ! $ #) IMMER IN
#    ANFÜHRUNGSZEICHEN SETZEN:
#        STRATO_SMTP_PASS="mein passwort & so$geheim"
#    Ohne Anführungszeichen führt die Shell den Rest als Befehl aus und
#    die Variable bleibt leer. tools/load-env.sh bricht dann ab.

# ---- Owner (wird nur im Server-Kontext gebraucht) ----
OWNER_USER=changeme
OWNER_PASS=changeme
OWNER_PHONE=+91515589471

# ---- Mail (Strato) ----
# Das Passwort setzt DU auf webmail.strato.com — hier nur der Name.
STRATO_SMTP_HOST=smtp.strato.de
STRATO_SMTP_PORT=465
STRATO_SMTP_USER=contact@maxichen.de
STRATO_SMTP_PASS=changeme
MAIL_FROM_NAME=MaxiChen

# 1 = Mails nur nach data/mail-outbox.jsonl (Test) · 0 = echt verschicken
MAIL_SIMULATE=1

# ---- WhatsApp-Brücke (pair.js) ----
WA_PORT=3100
WA_SIMULATE=1
# Leer = automatisch erzeugt, landet in server/data/internal-token.txt
INTERNAL_TOKEN=

# ---- TURN (Anrufe, seit V4.7) ----
TURN_HOST=127.0.0.1
TURN_SECRET=changeme
TURN_REALM=maxichat.test

# ---- Server ----
PORT=7777
