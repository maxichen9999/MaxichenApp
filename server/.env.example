# =====================================================================
# 🔐 MaxiChen — Umgebungsvariablen (VORLAGE, kein echtes Passwort drin!)
# ---------------------------------------------------------------------
# So benutzen (auf dem Server):
#   cp .env.example .env
#   nano .env            # Werte eintragen
#   chmod 600 .env       # nur du darfst lesen
#   set -a; . ./.env; set +a
#   node server.js
#
# ⚠️ .env NIE ins ZIP, NIE zu Git, NIE in einen Chat.
# =====================================================================

# ---- E-Mail (Strato) — das Passwort setzt DU, hier steht keins ----
STRATO_SMTP_HOST=smtp.strato.de
STRATO_SMTP_PORT=465
STRATO_SMTP_USER=contact@maxichen.de
STRATO_SMTP_PASS=
MAIL_FROM_NAME=MaxiChen

# 1 = Mails werden nur in data/mail-outbox.jsonl geschrieben (Test ohne Postfach)
MAIL_SIMULATE=1

# ---- WhatsApp (pair.js) ----
WA_PORT=3100
WA_SESSION=Verifi
WA_PROFILE_NAME=MaxiChen Verifizierung
WA_PROFILE_ABOUT=Dein Code kommt gleich 💗 Nicht weitergeben.
# Leer lassen → wird automatisch erzeugt und in data/internal-token.txt gelegt
INTERNAL_TOKEN=
# 1 = nichts geht an WhatsApp, alles landet in data/wa-outbox.jsonl
WA_SIMULATE=1

# ---- TURN (seit V4.7) ----
TURN_HOST=127.0.0.1
TURN_SECRET=bitte-aendern
TURN_REALM=maxichat.test
